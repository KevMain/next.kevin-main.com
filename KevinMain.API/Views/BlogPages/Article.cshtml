@model KevinMain.API.Models.BlogArticleViewModel
@{
    Layout = null;
    var publishedIso = Model.PublishedAt?.ToString("O");
    var updatedIso = (Model.UpdatedAt ?? Model.PublishedAt)?.ToString("O");
}<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Model.PageTitle</title>
    <meta name="description" content="@Model.Description">
    <link rel="canonical" href="@Model.CanonicalUrl">
    <meta property="og:type" content="article">
    <meta property="og:title" content="@Model.Title">
    <meta property="og:description" content="@Model.Description">
    <meta property="og:url" content="@Model.CanonicalUrl">
    <meta property="og:site_name" content="@Model.SiteName">
    @if (publishedIso is not null)
    {
        <meta property="article:published_time" content="@publishedIso">
    }
    @if (updatedIso is not null)
    {
        <meta property="article:modified_time" content="@updatedIso">
    }
    <meta property="article:author" content="@Model.Author">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="@Model.Title">
    <meta name="twitter:description" content="@Model.Description">
    <script type="application/ld+json">@Html.Raw(Model.JsonLd)</script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Inter:wght@300;400;600&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            margin: 0;
            color: #cbd5e1;
            line-height: 1.7;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
            min-height: 100vh;
        }
        nav {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }
        nav .nav-inner {
            max-width: 1400px;
            margin: 0 auto;
            padding: 16px 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        nav .logo {
            font-family: 'Fira Code', monospace;
            font-weight: 500;
            font-size: 1.1rem;
            color: #e0e7ff;
            text-decoration: none;
        }
        nav .logo span {
            background: linear-gradient(135deg, #0ea5e9 0%, #a855f7 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        nav .links a {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            font-size: 0.95rem;
            color: #cbd5e1;
            text-decoration: none;
            margin-left: 24px;
        }
        nav .links a:hover { color: #0ea5e9; }
        header.hero {
            background: linear-gradient(135deg, #0a0e27 0%, #1a1f3a 100%);
            color: #fff;
            padding: 100px 20px 80px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        header.hero h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            max-width: 900px;
            margin: 0 auto 16px;
            font-size: 2.6rem;
            background: linear-gradient(135deg, #0ea5e9 0%, #a855f7 50%, #0ea5e9 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        header.hero .meta { color: rgba(255, 255, 255, 0.8); font-weight: 300; font-size: 0.95rem; position: relative; }
        header.hero .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
        }
        header.hero .orb-1 { width: 400px; height: 400px; top: -100px; left: -100px; background: radial-gradient(circle, rgba(14, 165, 233, 0.4), transparent 70%); }
        header.hero .orb-2 { width: 350px; height: 350px; bottom: -120px; right: -80px; background: radial-gradient(circle, rgba(168, 85, 247, 0.3), transparent 70%); }
        main { max-width: 800px; margin: 0 auto; padding: 60px 20px 80px; }
        article {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 40px;
            font-size: 1.05rem;
            font-weight: 300;
        }
        article h2, article h3, article h4 {
            font-family: 'Space Grotesk', sans-serif;
            color: #e0e7ff;
            line-height: 1.3;
        }
        article strong { color: #e0e7ff; }
        a { color: #0ea5e9; }
        a:hover { text-shadow: 0 0 12px rgba(14, 165, 233, 0.5); }
        code, pre { font-family: 'Fira Code', monospace; font-size: 0.9em; }
        code { background: rgba(15, 23, 42, 0.7); padding: 2px 6px; border-radius: 6px; color: #7dd3fc; }
        pre { background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.06); padding: 16px; border-radius: 12px; overflow-x: auto; }
        pre code { background: none; padding: 0; }
        blockquote { border-left: 4px solid #0ea5e9; margin-left: 0; padding-left: 16px; color: #94a3b8; }
        .back-link {
            display: inline-block;
            margin-top: 32px;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            text-decoration: none;
        }
        footer {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            padding: 32px 20px;
            text-align: center;
            color: #94a3b8;
            font-size: 0.9rem;
        }
        @@media (max-width: 640px) {
            header.hero h1 { font-size: 1.9rem; }
            article { padding: 24px; }
            nav .nav-inner { padding: 14px 20px; }
        }
    </style>
</head>
<body>
    <nav>
        <div class="nav-inner">
            <a class="logo" href="@(Model.SiteBaseUrl)/"><span>&lt;</span>KM<span>/&gt;</span></a>
            <div class="links">
                <a href="@(Model.SiteBaseUrl)/">Home</a>
                <a href="@(Model.SiteBaseUrl)/blog">Blog</a>
                <a href="@(Model.SiteBaseUrl)/contact">Contact</a>
            </div>
        </div>
    </nav>
    <header class="hero">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <h1>@Model.Title</h1>
        <p class="meta">
            By @Model.Author
            @if (Model.PublishedAt is not null)
            {
                <text>&middot; Published </text><time datetime="@publishedIso">@Model.PublishedAt.Value.ToString("d MMMM yyyy")</time>
            }
            @if (Model.UpdatedAt is not null)
            {
                <text>&middot; Updated </text><time datetime="@updatedIso">@Model.UpdatedAt.Value.ToString("d MMMM yyyy")</time>
            }
        </p>
    </header>
    <main>
        <article>
            @Model.BodyHtml
        </article>
        <a class="back-link" href="@(Model.SiteBaseUrl)/blog">&larr; Back to Blog</a>
    </main>
    <footer>
        &copy; @DateTimeOffset.UtcNow.Year @Model.SiteName &middot; Built with Vue.js &amp; .NET 10
    </footer>
</body>
</html>
