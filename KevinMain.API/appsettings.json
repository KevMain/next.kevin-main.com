{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BlogStorage": {
    "ServiceUri": "https://{your-storage-account}.table.core.windows.net",
    "TableName": "blogposts"
  },
  "BlogCache": {
    "PostDuration": "01:00:00",
    "PublishedListDuration": "00:30:00",
    "NotFoundDuration": "00:05:00"
  },
  "CachingSettings": {
    "CVCacheDurationHours": 24
  },
  "SmtpSettings": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseSsl": true,
    "Username": "your-email@gmail.com",
    "Password": "your-app-specific-password",
    "FromEmail": "your-email@gmail.com",
    "FromName": "Kevin Main Portfolio",
    "ToEmail": "your-email@example.com"
  },
  "StravaSettings": {
    "Enabled": false,
    "ClientId": "",
    "ClientSecret": "",
    "RefreshToken": ""
  }
}
